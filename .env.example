# GeoVision.AI — configuração do deploy.
#
#   cp .env.example .env   e preencha.
#
# Este arquivo é lido em dois lugares: pelo docker compose (para PORTA_WEB e
# as variáveis do Traefik) e pelo container da API (para o resto). Nunca
# commite o .env preenchido.

# ==============================================================================
# Publicação
# ==============================================================================

# Porta onde o app fica acessível na VPS: http://SEU-IP:8080
# Só é usada quando você NÃO está atrás do Traefik. Troque se 8080 já estiver
# ocupada — confira com `ss -tlnp | grep 8080`.
PORTA_WEB=8080

# --- Somente para docker-compose.traefik.yml ---------------------------------
# Domínio ou hostname que o Traefik vai atender. Sem domínio próprio, um
# hostname nip.io aponta para o seu IP automaticamente e ainda assim recebe
# certificado Let's Encrypt — troque os pontos do IP por hífens:
#   IP 203.0.113.45  ->  geovision.203-0-113-45.nip.io
DOMINIO_GEOVISION=

# Rede docker onde o Traefik do n8n está. Descubra com:
#   docker inspect $(docker ps -qf name=traefik) --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
REDE_TRAEFIK=

# Nome do certificate resolver configurado no Traefik. No template de n8n da
# Hostinger costuma ser "mytlschallenge". Confira com:
#   docker inspect $(docker ps -qf name=traefik) --format '{{json .Args}}' | tr ',' '\n' | grep certificatesresolvers
RESOLVEDOR_TLS=mytlschallenge

# ==============================================================================
# API — serviço de classificação
# ==============================================================================

AMBIENTE=producao

# OBRIGATÓRIO com AMBIENTE=producao — a API se recusa a subir sem isto.
# Gere com:  openssl rand -hex 32
# Trocar o valor derruba todas as sessões ativas.
SEGREDO_JWT=

EXPIRACAO_TOKEN_HORAS=72

# Sem a chave o serviço sobe, mas os alertas chegam ao painel sem nível de
# risco, para triagem manual.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=esther-quarterolli
ROBOFLOW_WORKFLOW_ID=

# Vazio: o nginx serve o app e a API na mesma origem, então nenhuma origem
# externa precisa de liberação de CORS.
ORIGENS_PERMITIDAS=[]

# Modelo ONNX próprio (Sprint 5). Enquanto não existir, a classificação fica
# por conta do Roboflow.
CAMINHO_MODELO=models/geovision-risco.onnx
VERSAO_MODELO=sem-modelo
LIMIAR_CONFIANCA=0.60

# --- Notificações (opcionais) -------------------------------------------------
WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_REMETENTE=alertas@geovision.ai
EMAIL_DEFESA_CIVIL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=

# --- Supabase (legado; hoje os dados ficam no SQLite) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
