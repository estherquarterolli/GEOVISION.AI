# GeoVision.AI — Frontend
# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Supabase — painel do projeto > Settings > API
# A chave anon é pública por design; a segurança vem das políticas de RLS
# definidas em supabase/migrations/0001_esquema_inicial.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Serviço de classificação de risco (FastAPI)
# 8001, não 8000 — a 8000 colide com outro projeto local nesta máquina.
VITE_AI_SERVICE_URL=http://localhost:8001

# Nome do bucket de fotos no Supabase Storage
VITE_STORAGE_BUCKET=alertas
