# Dependências
node_modules/
.pnp
.pnp.js

# Build
dist/
dist-ssr/
build/
*.local

# Ambiente — NUNCA commitar chaves
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Modelos treinados (grandes — usar Git LFS ou storage externo)
*.h5
*.onnx
*.tflite
*.pt
ai-service/models/*
!ai-service/models/.gitkeep
# Artefato experimental aprovado para o MVP privado. Os demais modelos
# continuam fora do repositório por padrão.
!ai-service/models/geovision_model_pronto.keras
!ai-service/models/geovision_model_pronto.json
!ai-service/models/avaliacao.json

# Dataset de imagens (não versionar imagens brutas)
# Ignora o conteúdo, não a pasta: o Git não consegue reincluir um arquivo
# dentro de um diretório ignorado, e o .gitkeep sumiria junto.
ai-service/dataset/*
!ai-service/dataset/.gitkeep

# Banco local e fotos enviadas — dados de usuário, não código.
# Se geovision.db já estiver versionado: git rm --cached ai-service/geovision.db
ai-service/geovision.db
ai-service/geovision.db-wal
ai-service/geovision.db-shm
ai-service/uploads/

# Editor / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
logs/

# Supabase local
supabase/.temp/
supabase/.branches/
