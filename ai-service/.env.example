# GeoVision.AI — Serviço de Classificação
# Copie para .env e preencha. NUNCA commite o .env.

# "producao" ativa as travas de segurança na subida (ver app/config.py).
AMBIENTE=desenvolvimento

# --- Sessão -------------------------------------------------------------------
# Assina os tokens de login. Obrigatório quando AMBIENTE=producao.
# Gere com:  openssl rand -hex 32
# Trocar este valor invalida todas as sessões ativas.
SEGREDO_JWT=
EXPIRACAO_TOKEN_HORAS=72

# --- Modelo -------------------------------------------------------------------
# Preenchido a partir do Sprint 5, quando o MobileNetV2 treinado for exportado.
CAMINHO_MODELO=models/geovision_model_pronto.h5
VERSAO_MODELO=mobilenetv2-h5-v1
LIMIAR_CONFIANCA=0.60

# --- Supabase -----------------------------------------------------------------
# Herdado da arquitetura original; hoje os dados ficam no SQLite local e estes
# campos só são usados pelos webhooks.
SUPABASE_URL=
# ATENÇÃO: a service_role ignora RLS. Só no servidor, nunca no frontend.
SUPABASE_SERVICE_KEY=

# --- Webhooks -----------------------------------------------------------------
# Mesmo valor configurado no header X-Webhook-Secret de quem chama.
# Gere algo longo e aleatório.
WEBHOOK_SECRET=

# --- Notificações -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE=alertas@geovision.ai
EMAIL_DEFESA_CIVIL=

# Opcional — o serviço funciona só com e-mail se estes ficarem vazios.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=

# --- CORS ---------------------------------------------------------------------
# Em produção o nginx serve frontend e API na mesma origem, então nenhuma
# origem externa precisa ser liberada: deixe [] .
ORIGENS_PERMITIDAS=["http://localhost:5180","http://127.0.0.1:5180"]

# --- Dados --------------------------------------------------------------------
# Onde ficam geovision.db e uploads/. Vazio = ao lado do código (dev).
# No container o compose define /data, que é um volume.
# GEOVISION_DATA_DIR=/data
