# GeoVision.AI — Serviço de Classificação
# Copie para .env e preencha. NUNCA commite o .env.

AMBIENTE=desenvolvimento

# --- Modelo -------------------------------------------------------------------
# Preenchido a partir do Sprint 5, quando o MobileNetV2 treinado for exportado.
CAMINHO_MODELO=models/geovision-risco.onnx
VERSAO_MODELO=sem-modelo
LIMIAR_CONFIANCA=0.60

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# ATENÇÃO: a service_role ignora RLS. Só no servidor, nunca no frontend.
SUPABASE_SERVICE_KEY=

# --- Webhooks -----------------------------------------------------------------
# Mesmo valor configurado no Database Webhook do Supabase, no header
# X-Webhook-Secret. Gere algo longo e aleatório.
WEBHOOK_SECRET=

# --- Notificações -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE=alertas@geovision.ai
EMAIL_DEFESA_CIVIL=

# Opcional — o serviço funciona só com e-mail se estes ficarem vazios.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=

# --- CORS ---------------------------------------------------------------------
ORIGENS_PERMITIDAS=["http://localhost:5180"]
